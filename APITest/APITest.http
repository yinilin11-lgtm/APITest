@APITest_HostAddress = http://localhost:5048

# Auto route: normal chat.
POST {{APITest_HostAddress}}/ChatBot
Content-Type: application/json

{
  "userId": "iris",
  "conversationName": "自動判斷",
  "message": "我想點午餐，有什麼簡單建議？"
}

###

# Auto route: URL reader. The normal ChatBot endpoint detects the URL.
POST {{APITest_HostAddress}}/ChatBot
Content-Type: application/json

{
  "userId": "iris",
  "conversationName": "自動判斷",
  "message": "請幫我整理這個網頁：https://example.com"
}

###

# Auto route: search. The normal ChatBot endpoint detects that this needs recent information.
POST {{APITest_HostAddress}}/ChatBot
Content-Type: application/json

{
  "userId": "iris",
  "conversationName": "自動判斷",
  "message": "最近 iPhone 有什麼最新消息？"
}

###

# Manual route: read a URL with Jina Reader, then ask Gemini to summarize it.
POST {{APITest_HostAddress}}/ChatBot/read-url
Content-Type: application/json

{
  "userId": "iris",
  "conversationName": "網頁摘要",
  "url": "https://example.com",
  "question": "請用簡單中文整理這個網頁重點"
}

###

# Manual route: search the web with Jina Search, then ask Gemini to answer from the results.
POST {{APITest_HostAddress}}/ChatBot/search
Content-Type: application/json

{
  "userId": "iris",
  "conversationName": "搜尋",
  "query": "2026 iPhone 最新消息",
  "question": "請用簡單中文整理三個重點"
}

###

# List Iris conversations.
GET {{APITest_HostAddress}}/ChatBot/users/iris/conversations
Accept: application/json

###

# Show Iris current chat history.
GET {{APITest_HostAddress}}/ChatBot/users/iris/history
Accept: application/json

###

# Show Iris auto-route history by conversationName.
GET {{APITest_HostAddress}}/ChatBot/users/iris/history?conversationName=自動判斷
Accept: application/json

###

# Clear a conversation by conversationId.
DELETE {{APITest_HostAddress}}/ChatBot/replace-with-returned-conversation-id

###
