{
  "info": {
    "name": "APITest Toyota Advisor",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5048"
    },
    {
      "key": "userId",
      "value": "iris"
    },
    {
      "key": "conversationName",
      "value": "toyota-shopping"
    },
    {
      "key": "conversationId",
      "value": "replace-with-returned-conversation-id"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET Health Check",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ChatBot/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ChatBot",
                "health"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Toyota Chat",
      "item": [
        {
          "name": "POST Toyota Recommendation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"conversationName\": \"{{conversationName}}\",\n  \"message\": \"I commute every day and want an affordable, fuel-saving Toyota. What would you recommend?\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/ChatBot",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ChatBot"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "History",
      "item": [
        {
          "name": "GET All Conversations",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ChatBot/conversations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ChatBot",
                "conversations"
              ]
            }
          }
        },
        {
          "name": "GET User Conversations",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ChatBot/users/{{userId}}/conversations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ChatBot",
                "users",
                "{{userId}}",
                "conversations"
              ]
            }
          }
        },
        {
          "name": "GET Chat History",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ChatBot/users/{{userId}}/history?conversationName={{conversationName}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ChatBot",
                "users",
                "{{userId}}",
                "history"
              ],
              "query": [
                {
                  "key": "conversationName",
                  "value": "{{conversationName}}"
                }
              ]
            }
          }
        },
        {
          "name": "DELETE Chat History",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ChatBot/users/{{userId}}/history?conversationName={{conversationName}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ChatBot",
                "users",
                "{{userId}}",
                "history"
              ],
              "query": [
                {
                  "key": "conversationName",
                  "value": "{{conversationName}}"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
